{
  "name": "to-caption",
  "version": "1.0.4",
  "description": "Converts camelCase and delimited strings to captions",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "prepublish": "webpack",
    "release:legacy": "./node_modules/.bin/babel src/index.js --out-file dist/legacy.js",
    "release:es2015": "./node_modules/.bin/babel src/index.js --out-file dist/es2015.js --no-babelrc",
    "test": "./node_modules/.bin/mocha --require @babel/register test/"
  },
  "keywords": [
    "label",
    "caption",
    "camelcase",
    "ui",
    "gui",
    "editor"
  ],
  "author": "Steven Spungin",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^7.4.4",
    "@babel/core": "^7.4.4",
    "@babel/node": "^7.2.2",
    "@babel/plugin-transform-runtime": "^7.4.4",
    "@babel/preset-env": "^7.4.4",
    "@babel/register": "^7.4.4",
    "babel-loader": "^8.0.5",
    "babel-plugin-transform-commonjs": "^1.1.5",
    "babel-plugin-transform-commonjs-es2015-modules": "^4.0.1",
    "chai": "^4.2.0",
    "mocha": "^6.1.4",
    "webpack": "^4.30.0",
    "webpack-cli": "^3.3.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flamenco/to-caption.git"
  },
  "bugs": "https://github.com/flamenco/to-caption/issues",
  "xbrowserslist": "> 0.25%, not dead"
}
